{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CapturesFile",
  "type": "object",
  "required": [
    "test"
  ],
  "properties": {
    "description": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "test": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CapturesCase"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CapturesCase": {
      "type": "object",
      "required": [
        "name",
        "pattern"
      ],
      "properties": {
        "ascii": {
          "default": false,
          "type": "boolean"
        },
        "compile_only": {
          "default": false,
          "type": "boolean"
        },
        "expect_error": {
          "default": false,
          "type": "boolean"
        },
        "full": {
          "default": false,
          "type": "boolean"
        },
        "groups": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint",
                "minimum": 0.0
              }
            }
          }
        },
        "ignore": {
          "default": false,
          "type": "boolean"
        },
        "implicit_captures": {
          "default": false,
          "type": "boolean"
        },
        "input": {
          "default": "",
          "type": "string"
        },
        "javascript": {
          "default": false,
          "type": "boolean"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "matches": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint",
              "minimum": 0.0
            },
            "maxItems": 2,
            "minItems": 2
          }
        },
        "name": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}